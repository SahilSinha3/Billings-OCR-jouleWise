# JouleWise Backend Environment Configuration Example
APP_NAME=JouleWise Enterprise OCR
ENVIRONMENT=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# Database & Cache (PostgreSQL 17 & Redis)
DATABASE_URL=postgresql+asyncpg://sahilsinha@localhost:5432/joulewise_db
REDIS_URL=redis://localhost:6379/0

# OCR Engine Paths (Homebrew macOS default paths)
TESSERACT_CMD=/opt/homebrew/bin/tesseract
POPPLER_PATH=/opt/homebrew/bin

# AI Summarization & Field Extraction
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
GEMINI_API_KEY=

# Security
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
JWT_SECRET_KEY=dev_secret_key_change_in_production_983719471928471
